% -----------------------------------------------------------------------------
% H -> gamma gamma discovery-paper category model for ATLAS Open Data 13 TeV 2025
% Histogram-cache version: the ntuple selections were already applied and the
% resulting TRExFitter histograms are available under /histograms/hyy/Histograms.
% -----------------------------------------------------------------------------

% --------------- %
% ---  JOB    --- %
% --------------- %

Job: "hyy"
  Label: "H#rightarrow#gamma#gamma discovery-inspired merged categories"
  CmeLabel: "13 TeV"
  POI: "mu_H"
  % Configure this job to read the prepared histogram cache from /histograms.
  LumiLabel: "36.1 fb^{-1}"
  Lumi: 36100
  DebugLevel: 1
  PlotOptions: "NOXERR"
  SystControlPlots: TRUE
  SystCategoryTables: TRUE
  CorrelationThreshold: 0.2
  MCstatThreshold: 0.01

% --------------- %
% ---  FIT    --- %
% --------------- %

Fit: "fit"
  FitType: SPLUSB
  FitRegion: CRSR
  POIAsimov: 1

% --------------- %
% --- REGIONS --- %
% --------------- %

% Add all signal regions for this category model here.
% Use histogram names that match the cache contents and provide coherent labels.


% --------------- %
% --- SAMPLES --- %
% --------------- %

% Add the observed data, diphoton continuum background, and Higgs production
% samples available in the histogram cache here.


% -------------------- %
% --- NORM FACTORS --- %
% -------------------- %

NormFactor: "mu_H"
  Samples: ggH,VBFH,WH,ZH,ttH
  Title: "#mu_{H}"
  Nominal: 1
  Min: 0
  Max: 50

NormFactor: "mu_yy_cat_2jet"
  Samples: diphoton
  Regions: cat_2jet
  Title: "#mu_{#gamma#gamma,2j}"
  Nominal: 1
  Min: 0
  Max: 10

NormFactor: "mu_yy_cat_central_lowptt"
  Samples: diphoton
  Regions: cat_central_lowptt
  Title: "#mu_{#gamma#gamma,central low pTt}"
  Nominal: 1
  Min: 0
  Max: 10

NormFactor: "mu_yy_cat_central_highptt"
  Samples: diphoton
  Regions: cat_central_highptt
  Title: "#mu_{#gamma#gamma,central high pTt}"
  Nominal: 1
  Min: 0
  Max: 10

NormFactor: "mu_yy_cat_rest_lowptt"
  Samples: diphoton
  Regions: cat_rest_lowptt
  Title: "#mu_{#gamma#gamma,rest low pTt}"
  Nominal: 1
  Min: 0
  Max: 10

NormFactor: "mu_yy_cat_rest_highptt"
  Samples: diphoton
  Regions: cat_rest_highptt
  Title: "#mu_{#gamma#gamma,rest high pTt}"
  Nominal: 1
  Min: 0
  Max: 10

NormFactor: "mu_yy_cat_transition"
  Samples: diphoton
  Regions: cat_transition
  Title: "#mu_{#gamma#gamma,transition}"
  Nominal: 1
  Min: 0
  Max: 10
